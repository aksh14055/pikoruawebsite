import { LOCATION_LANDING_PAGES, PROPERTY_TYPE_LANDING_PAGES } from "@/lib/data/geo";

function humanizeSlug(slug: string): string {
  return slug.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}

// Most of the site's landing pages live at flat root-level URLs (e.g.
// "/luxury-villas-ahmedabad", "/thaltej-properties") rather than under a
// "/locations/" or "/property-types/" prefix, so route segments alone can't
// identify them — build a direct href → label lookup from the real page data.
const LOCATION_LABEL_BY_HREF = new Map(
  LOCATION_LANDING_PAGES.map((page) => [page.href, page.label])
);
const PROPERTY_TYPE_LABEL_BY_HREF = new Map(
  PROPERTY_TYPE_LANDING_PAGES.map((page) => [page.href, page.label])
);

/**
 * Maps the current route to a short clause so Maya's popup can reference
 * what the visitor is actually looking at, instead of a generic script.
 * Returns null for pages with no natural contextual hook.
 */
export function getCallAgentContext(pathname: string | null): string | null {
  if (!pathname) return null;

  const locationLabel = LOCATION_LABEL_BY_HREF.get(pathname);
  if (locationLabel) return `about luxury homes in ${locationLabel}`;

  const propertyTypeLabel = PROPERTY_TYPE_LABEL_BY_HREF.get(pathname);
  if (propertyTypeLabel) return `about ${propertyTypeLabel}`;

  const segments = pathname.split("/").filter(Boolean);
  if (segments.length === 0) return null;

  const [first, second] = segments;

  switch (first) {
    case "properties":
      return second ? "about this residence" : "about our curated residences";
    case "locations":
      return second ? `about luxury homes in ${humanizeSlug(second)}` : "about our Ahmedabad corridors";
    case "property-types":
      return second ? `about ${humanizeSlug(second)}` : "about our property types";
    case "nri":
      return "about NRI property investment in Ahmedabad";
    case "gift-city":
      return "about GIFT City opportunities";
    case "private-client-advisory":
      return "about private client advisory";
    case "ahmedabad":
      return second ? `about ${humanizeSlug(second)} in Ahmedabad` : null;
    case "invest":
      return second ? `about investing in ${humanizeSlug(second)}` : null;
    case "compare":
      return second ? `comparing ${humanizeSlug(second)}` : null;
    case "p":
      return "about this search";
    default:
      return null;
  }
}
